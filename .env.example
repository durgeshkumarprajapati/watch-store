# WatchStore Environment Configuration
# Copy this file to .env.local (or .env for Prisma CLI) and fill in real values.
# NEVER commit .env or real credentials to version control.
# NEVER expose database credentials via NEXT_PUBLIC_* variables.

# ==============================================================================
# PostgreSQL + Prisma (Phase 5)
# ==============================================================================
# Required in production and for database-backed development/testing.
# For Supabase PostgreSQL, use the Transaction/Session pooler URL here
# (e.g. port 6543 with ?pgbouncer=true) and the direct URL below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/watch_store?schema=public"

# Direct non-pooled connection URL used by Prisma CLI (`prisma migrate deploy` / `migrate dev`).
# For local PostgreSQL, this can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/watch_store?schema=public"

# Optional isolated test database URL for integration tests (`tests/integration/postgres.test.ts`).
# Never point TEST_DATABASE_URL at a production or shared development database.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/watch_store_test?schema=public"

# ==============================================================================
# Razorpay Payment Gateway (Phase 6)
# ==============================================================================
# Use Razorpay Test Mode keys (rzp_test_...) in development.
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to client bundles.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ==============================================================================
# Customer Authentication & Email (Phase 7)
# ==============================================================================
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional Google OAuth (Auth.js Google Provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Transactional Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="WatchStore <no-reply@example.com>"

# ==============================================================================
# Shiprocket Shipping Integration (Phase 12)
# ==============================================================================
# Dedicated Shiprocket API user credentials (never use your main panel login).
SHIPROCKET_API_EMAIL=""
SHIPROCKET_API_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE="400001"
# Shared secret configured in Shiprocket Panel -> Webhooks (sent in x-api-key header).
SHIPROCKET_WEBHOOK_TOKEN=""
# Secret for authenticated scheduled tracking sync endpoint (/api/internal/shipping/sync).
SHIPROCKET_CRON_SECRET=""
# Dedicated secret for Vercel Cron / internal operations scheduler routes (GET/POST Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# ==============================================================================
# Google Sheets Catalogue Integration (Phase 14)
# ==============================================================================
# Google Cloud Service Account credentials (never expose to browser).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ==============================================================================
# Cloudinary Media Storage (Phase 15)
# ==============================================================================
# Server-only Cloudinary credentials (never expose API secret to browser).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# Seller & Tax Invoice Details (Phase 18)
# ==============================================================================
# Authoritative legal business details printed on customer PDF invoices.
# Never use placeholder values in production.
SELLER_LEGAL_NAME=""
SELLER_ADDRESS=""
SELLER_STATE=""
SELLER_GSTIN=""
SELLER_EMAIL=""
SELLER_PHONE=""

# ==============================================================================
# Local QA & Preview Flags (NEVER set in hosted production)
# ==============================================================================
# Optional: Custom Next.js build output directory (default: .next).
# QA scripts (`npm run qa:build` / `npm run qa:start`) use `.next-build`.
# NEXT_DIST_DIR=.next-build

# Optional (Local QA only — NEVER set in hosted production):
# Explicitly forces the fictional development seed catalogue instead of PostgreSQL.
# CATALOGUE_SOURCE=seed

# Optional (Local QA only — NEVER set in hosted production):
# Displays unverified Stitch placeholder claims (warranty, insured transit, heritage stats)
# for visual comparison against design references.
# SHOW_PLACEHOLDER_CLAIMS=true

# Optional (Local QA only — NEVER set in hosted production):
# Allows /admin/* to render in a production build before server-side auth & RBAC land.
# ALLOW_UNPROTECTED_ADMIN_PREVIEW=true

# ADMIN_PROVISION_EMAIL="admin@watchstore.com" 
# ADMIN_PROVISION_NAME="watch-store-admin" 
# ADMIN_PROVISION_PASSWORD="watchstoreadmin@123" 