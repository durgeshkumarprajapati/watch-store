{
  "name": "premium-watch-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const d of ['.next','.next-build']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "qa:build": "NEXT_DIST_DIR=.next-build next build",
    "qa:start": "NEXT_DIST_DIR=.next-build ALLOW_UNPROTECTED_ADMIN_PREVIEW=true CATALOGUE_SOURCE=seed SHOW_PLACEHOLDER_CLAIMS=true next start -p 3000",
    "test": "vitest run",
    "test:db": "RUN_DB_TESTS=1 TEST_DATABASE_URL='' node --env-file=.env ./node_modules/.bin/vitest run --no-file-parallelism tests/integration/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "rbac:seed": "tsx --env-file=.env prisma/seed-rbac.ts",
    "admin:create": "tsx --env-file=.env prisma/create-admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "clsx": "^2.1.1",
    "material-symbols": "^0.49.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.9",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
